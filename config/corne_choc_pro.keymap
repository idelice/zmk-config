#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/*
 * Tap-preferred hold-taps: a quick tap stays a tap even when the next key is
 * pressed, so fast typing does not turn letters into their held (number) value.
 * Holding past tapping-term-ms still triggers the hold behavior.
 */
&mt {
    flavor = "tap-preferred";
};

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |
            bindings = <
                &kp TAB   &lt 2 Q &lt 1 W &kp E &kp R &kp T &trans &trans   &kp Y &kp U  &kp I     &kp O   &kp P    &kp EQUAL
                &kp LGUI  &kp A &kp S &kp D &kp F &kp G &trans     &trans   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B                     &kp N &kp M  &kp COMMA &kp DOT &mt BSLH FSLH &kp ESC
                                      &kp LALT &kp LCTRL &lt 4 SPACE        &kp RET &kp BSPC &tog 3
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        lower_layer {
            display-name = "NUMBER";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | CTRL | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |      |
            // | SHFT | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |      |
            //                    | GUI |     | SPC   |        | ENT   |     | ALT |
            bindings = <
                &kp TAB   &trans       &trans          &trans       &trans       &trans       &trans    &trans    &kp N0   &kp N1   &kp N2 &kp N3    &trans &trans
                &kp LCTRL &bt BT_SEL 0 &bt BT_SEL 1    &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans    &trans    &trans   &kp N4   &kp N5 &kp N6    &trans &trans
                &kp LSHFT &bt BT_CLR   &none           &sys_reset   &bootloader  &studio_unlock                   &trans   &kp N7   &kp N8 &kp N9    &trans &trans
                                                       &kp LGUI     &trans       &kp SPACE                        &kp LGUI &trans   &kp SPACE
            >;
        };

        raise_layer {
            display-name = "SYMBOL";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  | LCTRL | RCTRL |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL | HUD | HUI |     |     |     |  LALT | RALT  |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |               | ENT |     | ALT |
            bindings = <
                &kp TAB   &kp EXCL        &kp AT          &kp EXCL &kp AMPS &kp PRCNT &kp LCTRL &kp RCTRL &kp HASH  &kp DLLR  &kp LPAR  &kp RPAR &kp LBRC &kp RBRC
                &kp LCTRL &trans          &trans          &kp CARET &mt UNDER MINUS &kp ASTRK &kp LALT &kp RALT &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp LBKT &kp RBKT
                &kp LSHFT &trans          &trans          &trans   &trans   &trans                        &none     &none     &none     &none    &kp PIPE &kp TILDE
                                                          &kp LGUI &trans   &kp SPACE                     &kp RET   &trans    &kp RALT
            >;
        };

        extra_layer_1 {
            display-name = "GAMING";
            bindings = <
                &mt TAB ESC &kp Q &kp W &trans &trans &trans &trans &trans &mt N0 Y &mt N1 U &mt N2 I &mt N3 O &trans &kp LA(F5)
                &kp LCTRL &trans &trans &trans &trans &trans &trans &trans &trans &mt N4 J &mt N5 K &mt N6 L &trans &kp LGUI
                &kp LSHFT &trans &trans &trans &trans &trans            &trans &mt N7 M &mt N8 COMMA &mt N9 DOT &trans &trans
                                     &kp RET &kp LALT &kp SPACE         &kp RET &trans &tog 3
            >;
        };

        extra_layer_2 {
            display-name = "AEROSPACE";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &kp LS(LC(BSLH)) &kp LA(N1) &kp LA(N2) &kp LA(N3) &kp LS(LC(L)) &kp LS(LC(K))
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp LA(N4) &kp LA(N5) &kp LA(N6) &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &kp LS(LC(BSPC)) &trans
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };
    };
};
